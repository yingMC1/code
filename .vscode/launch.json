{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "调试 C++ (cppdbg)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${fileDirname}\\${fileBasenameNoExtension}.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${fileDirname}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "D:\\mingw\\bin\\gdb.exe",
      "setupCommands": [
        {
          "description": "为gdb启用整齐打印",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "C++ 编译 (调试版 - 无优化)"
    }
  ]
}
