{
  // ========== C/C++ 插件：只负责补全和语法高亮 ==========
  "C_Cpp.intelliSenseEngine": "default", // 智能提示
  "C_Cpp.autocomplete": "default", // 自动补全
  "C_Cpp.errorSquiggles": "disabled", // 禁用错误检查（交给clangd）
  "C_Cpp.enhancedColorization": "enabled", // 语法高亮
  "C_Cpp.intelliSenseUpdateDelay": 300, // 减少延迟

  // ========== clangd：负责错误检查和编译 ==========
  "clangd.path": "clangd",
  "clangd.arguments": [
    "--background-index",
    "--clang-tidy",
    "--header-insertion=iwyu",
    "--completion-style=detailed",
    "--function-arg-placeholders",
    "--compile-commands-dir=${workspaceFolder}"
  ],
  "clangd.fallbackFlags": [
    "-std=c++23",
    "-I D:/mingw/include",
    "-I D:/mingw/lib/gcc/x86_64-w64-mingw32/16.1.0/include",
    "-I D:/mingw/lib/gcc/x86_64-w64-mingw32/16.1.0/include/c++",
    "-I D:/mingw/lib/gcc/x86_64-w64-mingw32/16.1.0/include/c++/x86_64-w64-mingw32"
  ],

  // ========== 编辑器设置 ==========
  "editor.formatOnSave": true,
  "editor.suggest.snippetsPreventQuickSuggestions": false,
  "files.associations": {
    "*.cpp": "cpp",
    "*.h": "cpp"
  }
}
